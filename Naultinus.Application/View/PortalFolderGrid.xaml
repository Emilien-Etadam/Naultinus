<UserControl x:Class="Naultinus.View.PortalFolderGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             xmlns:properties="clr-namespace:Naultinus.Properties"
             xmlns:converters="clr-namespace:Naultinus.Converters"
             Focusable="True"
             IsTabStop="True"
             Background="Transparent"
             MouseLeftButtonDown="Grid_MouseLeftButtonDown"
             AllowDrop="True"
             Drop="OnExternalFileDrop"
             DragOver="OnExternalFileDragOver">
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    <!-- Sans teinte : fond thème. Avec teinte : transparent pour laisser LayoutRoot (alpha) voir le bureau. -->
    <Border ClipToBounds="True"
            MouseRightButtonUp="Background_MouseRightButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding BodyBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UsesBodyTint}" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                       Foreground="{DynamicResource NaultinusErrorBrush}"
                       FontSize="13"
                       Margin="15,10"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                <ItemsControl ItemsSource="{Binding Items}" Margin="10"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DragHandler="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="100" Margin="0,10" CornerRadius="3" Cursor="Hand"
                                    ContextMenu="{x:Null}"
                                    ContextMenuOpening="Item_ContextMenuOpening"
                                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                    MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                    MouseRightButtonUp="Item_MouseRightButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NaultinusCardHoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource NaultinusSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                                    <Image Source="{Binding PreviewPath, Converter={StaticResource PathToImage}, ConverterParameter=48}"
                                           Width="48" Height="48" Stretch="UniformToFill" Margin="5"/>
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                               ToolTip="{Binding Name, Mode=OneWay}"
                                               TextWrapping="NoWrap"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource NaultinusTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="5,0,5,5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
