<Window x:Class="Naultinus.View.CreateCalendarNaultinusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Naultinus.Properties"
        Title="{x:Static properties:Strings.WindowTitleNewCalendarNaultinus}" MinHeight="420" Height="480" MinWidth="480" Width="520"
        Background="{DynamicResource NaultinusWindowBrush}"
        TextElement.Foreground="{DynamicResource NaultinusTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Styles/NaultinusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="{x:Static properties:Strings.LabelTitle}" Grid.Row="0" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="NaultinusTitleTextBox" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource NaultinusDialogTextBox}" Text="{Binding NaultinusTitle, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock x:Name="AccountStatusText" Grid.Row="2" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NaultinusSubtleBrush}"/>
        <CheckBox x:Name="LocalOnlyCheckBox" Grid.Row="3" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogCheckBox}" Content="{x:Static properties:Strings.CheckBoxLocalOnly}" Checked="LocalOnlyCheckBox_Changed" Unchecked="LocalOnlyCheckBox_Changed"/>
        <Button x:Name="LoadCalendarsButton" Grid.Row="4" Content="{x:Static properties:Strings.ButtonLoadCalendars}" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogButton}" Click="LoadCalendarsButton_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="{x:Static properties:Strings.LabelCalendarsToShow}" Grid.Row="5" Style="{StaticResource NaultinusDialogLabel}"/>
        <ListBox x:Name="CalendarsListBox" Grid.Row="6" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogListBox}" SelectionMode="Multiple" DisplayMemberPath="DisplayName" SelectionChanged="CalendarsListBox_SelectionChanged"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static properties:Strings.ButtonCancel}" Width="80" Margin="0,0,10,0" Style="{StaticResource NaultinusDialogButton}" Click="CancelButton_Click"/>
            <Button x:Name="CreateButton" Content="{x:Static properties:Strings.ButtonCreate}" Width="80" IsDefault="True" Style="{StaticResource NaultinusDialogButton}" Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
