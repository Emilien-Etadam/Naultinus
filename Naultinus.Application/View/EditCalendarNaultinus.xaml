<Window x:Class="Naultinus.View.EditCalendarNaultinus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Naultinus.Properties"
        xmlns:view="clr-namespace:Naultinus.View"
        Title="{x:Static properties:Strings.WindowTitleEditCalendarNaultinus}" Height="720" Width="440" MinHeight="560" MinWidth="400"
        Background="{DynamicResource NaultinusWindowBrush}"
        TextElement.Foreground="{DynamicResource NaultinusTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Styles/NaultinusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="{x:Static properties:Strings.LabelNaultinusTitle}" Grid.Row="0" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource NaultinusDialogTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <view:NaultinusAppearanceEditor Grid.Row="2"/>
        <TextBlock Text="{x:Static properties:Strings.LabelDaysToShow}" Grid.Row="3" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="DaysToShowBox" Grid.Row="4" Margin="0,0,0,10" Style="{StaticResource NaultinusDialogTextBox}" Text="{Binding DaysToShow, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{x:Static properties:Strings.LabelViewMode}" Grid.Row="5" Style="{StaticResource NaultinusDialogLabel}"/>
        <ComboBox x:Name="ViewModeCombo" Grid.Row="6" Margin="0,0,0,10" Style="{StaticResource NaultinusDialogComboBox}"/>
        <TextBlock x:Name="AccountStatusText" Grid.Row="7" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NaultinusSubtleBrush}"/>
        <Button x:Name="LoadCalendarsButton" Grid.Row="8" Content="{x:Static properties:Strings.ButtonLoadCalendars}" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogButton}" Click="LoadCalendarsButton_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="{x:Static properties:Strings.LabelCalendarsToShow}" Grid.Row="9" Style="{StaticResource NaultinusDialogLabel}"/>
        <ListBox x:Name="CalendarsListBox" Grid.Row="10" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogListBox}" SelectionMode="Multiple" DisplayMemberPath="DisplayName" SelectionChanged="CalendarsListBox_SelectionChanged"/>
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static properties:Strings.ButtonCancel}" Width="80" Margin="0,0,10,0" Style="{StaticResource NaultinusDialogButton}" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="{x:Static properties:Strings.ButtonSave}" Width="80" IsDefault="True" Style="{StaticResource NaultinusDialogButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
