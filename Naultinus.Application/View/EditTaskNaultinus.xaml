<Window x:Class="Naultinus.View.EditTaskNaultinus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Naultinus.Properties"
        Title="{x:Static properties:Strings.WindowTitleEditTaskNaultinus}" Height="320" Width="500" MinHeight="280" MinWidth="420"
        Background="{DynamicResource NaultinusWindowBrush}"
        TextElement.Foreground="{DynamicResource NaultinusTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Styles/NaultinusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Text="{x:Static properties:Strings.LabelNaultinusTitle}" Grid.Row="0" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="NaultinusTitleTextBox" Grid.Row="1" Margin="0,0,0,15" Style="{StaticResource NaultinusDialogTextBox}"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock x:Name="AccountHintText" Grid.Row="2" Margin="0,0,0,15" TextWrapping="Wrap" Foreground="{DynamicResource NaultinusSubtleBrush}"/>

        <TextBlock Text="{x:Static properties:Strings.LabelTaskListId}" Grid.Row="3" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="TaskListIdTextBox" Grid.Row="4" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogTextBox}"
                 Text="{Binding TaskListId, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{x:Static properties:Strings.SharedCalDavListHint}" Grid.Row="5" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NaultinusSubtleBrush}" FontSize="11"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{x:Static properties:Strings.ButtonCancel}" Width="80" Margin="0,0,10,0" Style="{StaticResource NaultinusDialogButton}" Click="CancelButton_Click"/>
            <Button Content="{x:Static properties:Strings.ButtonSave}" Width="80" IsDefault="True" Style="{StaticResource NaultinusDialogButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
