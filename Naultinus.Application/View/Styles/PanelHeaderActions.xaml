<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:properties="clr-namespace:Naultinus.Properties"
                    xmlns:view="clr-namespace:Naultinus.View">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="NaultinusStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <view:PanelHeaderActionsSelector x:Key="PanelHeaderActionsSelector"/>

    <DataTemplate x:Key="EmptyHeaderActionsTemplate">
        <Grid/>
    </DataTemplate>

    <DataTemplate x:Key="TaskHeaderActionsTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="⟳" ToolTip="{x:Static properties:Strings.TooltipForceSync}" Command="{Binding ForceSyncCommand}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,0,0"
                    Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}"/>
            <Button Content="⚙" ToolTip="{x:Static properties:Strings.TooltipSettings}" Command="{Binding ShowSettingsCommand}" CommandParameter="{Binding}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,0,0"/>
            <Button Content="✎" ToolTip="{x:Static properties:Strings.TooltipEdit}" Command="{Binding EditCommand}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,8,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- ⚙ et ✎ ouvrent le même dialogue Modifier : jours, mode, titre et calendriers y sont déjà. -->
    <DataTemplate x:Key="CalendarHeaderActionsTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="⟳" ToolTip="{x:Static properties:Strings.TooltipRefresh}" Command="{Binding RefreshCommand}" CommandParameter="{Binding}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,0,0"/>
            <Button Content="⚙" ToolTip="{x:Static properties:Strings.TooltipSettings}" Command="{Binding ShowSettingsCommand}" CommandParameter="{Binding}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,0,0"/>
            <Button Content="✎" ToolTip="{x:Static properties:Strings.TooltipEdit}" Command="{Binding EditCommand}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,8,0"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MailHeaderActionsTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource NaultinusHighlightBrush}" CornerRadius="12" Padding="8,2" Margin="2,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalUnreadCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource NaultinusHighlightTextBrush}"/>
            </Border>
            <Button Content="⟳" ToolTip="{x:Static properties:Strings.TooltipRefresh}" Command="{Binding RefreshCommand}" CommandParameter="{Binding}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,8,0"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FolderHeaderActionsTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="&#x2190;" Command="{Binding NavigateBackCommand}"
                    ToolTip="{x:Static properties:Strings.TooltipNavigateBack}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,0,0"
                    Visibility="{Binding CanNavigateBack, Converter={StaticResource BoolToVis}}"/>
            <Button Content="&#x2302;" Command="{Binding NavigateToRootCommand}"
                    ToolTip="{x:Static properties:Strings.TooltipGoToRoot}"
                    Style="{StaticResource HeaderActionButton}" Margin="2,0,8,0"
                    Visibility="{Binding CanNavigateBack, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
