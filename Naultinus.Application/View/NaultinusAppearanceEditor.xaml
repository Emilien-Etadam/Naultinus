<UserControl x:Class="Naultinus.View.NaultinusAppearanceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:Naultinus.View"
             xmlns:properties="clr-namespace:Naultinus.Properties">
    <StackPanel>
        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold"
                   Text="{x:Static properties:Strings.LabelAppearance}"
                   Foreground="{DynamicResource NaultinusTextBrush}"/>

        <Grid Margin="0,2" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{x:Static properties:Strings.LabelHeaderColor}"
                       Foreground="{DynamicResource NaultinusTextBrush}"/>
            <view:ColorPickerButton Grid.Column="1" ColorHex="{Binding HeaderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="3" Content="×" Width="24" Height="24" Padding="0"
                    ToolTip="{x:Static properties:Strings.ButtonClearColor}"
                    Style="{DynamicResource NaultinusDialogButton}"
                    Click="ClearHeader_Click"/>
        </Grid>

        <Grid Margin="0,2" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{x:Static properties:Strings.LabelBodyColor}"
                       Foreground="{DynamicResource NaultinusTextBrush}"/>
            <view:ColorPickerButton Grid.Column="1" ColorHex="{Binding BodyColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="3" Content="×" Width="24" Height="24" Padding="0"
                    ToolTip="{x:Static properties:Strings.ButtonClearColor}"
                    Style="{DynamicResource NaultinusDialogButton}"
                    Click="ClearBody_Click"/>
        </Grid>

        <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{x:Static properties:Strings.LabelBodyOpacity}"
                       Foreground="{DynamicResource NaultinusTextBrush}"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="5"
                    Value="{Binding BodyOpacity, Mode=TwoWay}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Margin="8,0,0,0" Width="36" VerticalAlignment="Center"
                       Text="{Binding BodyOpacity, StringFormat={}{0}%}"
                       Foreground="{DynamicResource NaultinusSubtleBrush}"/>
        </Grid>

        <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{x:Static properties:Strings.LabelTitleColor}"
                       Foreground="{DynamicResource NaultinusTextBrush}"/>
            <view:ColorPickerButton Grid.Column="1" ColorHex="{Binding TitleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="3" Content="×" Width="24" Height="24" Padding="0"
                    ToolTip="{x:Static properties:Strings.ButtonClearColor}"
                    Style="{DynamicResource NaultinusDialogButton}"
                    Click="ClearTitle_Click"/>
        </Grid>

        <Grid Margin="0,2" ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="{x:Static properties:Strings.LabelLabelsColor}"
                       Foreground="{DynamicResource NaultinusTextBrush}"/>
            <view:ColorPickerButton Grid.Column="1" ColorHex="{Binding LabelsColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="3" Content="×" Width="24" Height="24" Padding="0"
                    ToolTip="{x:Static properties:Strings.ButtonClearColor}"
                    Style="{DynamicResource NaultinusDialogButton}"
                    Click="ClearLabels_Click"/>
        </Grid>

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="{x:Static properties:Strings.HintAppearanceShellOpaque}"
                   Foreground="{DynamicResource NaultinusSubtleBrush}"/>

        <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                Content="{x:Static properties:Strings.ButtonResetAppearance}"
                Style="{DynamicResource NaultinusDialogButton}"
                Click="Reset_Click"/>
    </StackPanel>
</UserControl>
