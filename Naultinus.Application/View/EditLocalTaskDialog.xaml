<Window x:Class="Naultinus.View.EditLocalTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Naultinus.Properties"
        Title="{x:Static properties:Strings.WindowTitleAddTask}" Width="420" Height="320" MinWidth="380" MinHeight="280"
        Background="{DynamicResource NaultinusWindowBrush}"
        TextElement.Foreground="{DynamicResource NaultinusTextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Styles/NaultinusStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Text="{x:Static properties:Strings.LabelEventSummaryRequired}" Grid.Row="0" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogTextBox}"/>
        <TextBlock Text="{x:Static properties:Strings.LabelDescription}" Grid.Row="2" Style="{StaticResource NaultinusDialogLabel}"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Margin="0,0,0,8" Style="{StaticResource NaultinusDialogTextBox}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="{x:Static properties:Strings.LabelDueDateOptional}" Grid.Row="4" Style="{StaticResource NaultinusDialogLabel}"/>
        <DatePicker x:Name="DueDatePicker" Grid.Row="5" Margin="0,0,0,8" Background="{DynamicResource NaultinusControlBrush}" Foreground="{DynamicResource NaultinusTextBrush}" BorderBrush="{DynamicResource NaultinusBorderBrush}"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static properties:Strings.ButtonCancel}" Width="80" Margin="0,0,10,0" Style="{StaticResource NaultinusDialogButton}" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="{x:Static properties:Strings.ButtonSave}" Width="80" IsDefault="True" Style="{StaticResource NaultinusDialogButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
